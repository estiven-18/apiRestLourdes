### Variables
@baseURL = http://localhost:3000

################################################################################
### USUARIOS
################################################################################

### Listar todos los usuarios
GET {{baseURL}}/usuario/listartodos

### Listar usuario por ID
GET {{baseURL}}/usuario/listarporid/1

### Crear nuevo usuario
POST {{baseURL}}/usuario/crearUsuario
Content-Type: application/json

{
  "nombre": "Juan Pérez",
  "documento": "12",
  "telefono": "555-1234",
  "contraseña": "123456",
  "rol": "medico"
}

### Editar usuario
PUT {{baseURL}}/usuario/editar/1
Content-Type: application/json

{
  "nombre": "Juan Pérez Actualizado",
  "documento": "100",
  "telefono": "555-5678",
  "contraseña": "654321",
  "rol": "usuario"
}

### Eliminar usuario
DELETE {{baseURL}}/usuario/borrar/1

